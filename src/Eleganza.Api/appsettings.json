{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Outbox": {
    "PollingIntervalSeconds": 30,
    "BatchSize": 10,
    "MaxAttempts": 5
  },
  "Shipping": {
    "DefaultFee": 0
  },
  "RateLimits": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "VendorLocationPermitLimit": 30,
    "VendorLocationWindowSeconds": 60
  },
  "Vanex": {
    "Enabled": false,
    "BaseUrl": "",
    "AllowedBaseUrls": [],
    "AllowInsecureHttp": false,
    "HttpTimeoutSeconds": 15,
    "CitiesPath": "",
    "SubCitiesPath": "",
    "CreateOrderPath": "",
    "DefaultPackageType": "",
    "DefaultLength": "",
    "DefaultWidth": "",
    "DefaultHeight": "",
    "DefaultBreakable": "",
    "DefaultReceiptMoney": "",
    "DefaultMeasuringIsAllowed": "",
    "DefaultStorageSubscription": "",
    "DefaultInspectionAllowed": "",
    "DefaultHeatIntolerance": "",
    "DefaultCasing": "",
    "DefaultPaidBy": "",
    "DefaultExtraSizeBy": "",
    "DefaultCommissionBy": "",
    "DefaultSaveAddress": "",
    "DefaultPaymentMethod": "",
    "DefaultPackageSubType": "",
    "DefaultTypeId": ""
  },
  "Security": {
    "RequireHttps": true,
    "CookieName": "__Host-Eleganza.Auth"
  },
  "DataProtection": {
    "RequirePersistentKeys": true,
    "KeyRingPath": ""
  },
  "AllowedHosts": "*"
}
