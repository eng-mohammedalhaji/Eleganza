{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eleganza;Username=eleganza;Password=eleganza"
  },
  "Shipping": {
    "DefaultFee": 0
  },
  "Vanex": {
    "Enabled": false,
    "BaseUrl": "https://api.vanextest.com.ly/api/v1",
    "AllowedBaseUrls": ["https://api.vanextest.com.ly/api/v1"],
    "AllowInsecureHttp": false,
    "HttpTimeoutSeconds": 15,
    "CitiesPath": "city/names",
    "SubCitiesPath": "city/{cityId}/subs",
    "CreateOrderPath": "customer/package",
    "DefaultPackageType": "1",
    "DefaultLength": "36",
    "DefaultWidth": "35",
    "DefaultHeight": "35",
    "DefaultBreakable": "0",
    "DefaultReceiptMoney": "false",
    "DefaultMeasuringIsAllowed": "1",
    "DefaultStorageSubscription": "false",
    "DefaultInspectionAllowed": "1",
    "DefaultHeatIntolerance": "1",
    "DefaultCasing": "false",
    "DefaultPaidBy": "market",
    "DefaultExtraSizeBy": "market",
    "DefaultCommissionBy": "market",
    "DefaultSaveAddress": "false",
    "DefaultPaymentMethod": "cash",
    "DefaultPackageSubType": "1",
    "DefaultTypeId": "1"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDevelopmentCatalog": true
  },
  "Outbox": {
    "PollingIntervalSeconds": 15,
    "BatchSize": 10,
    "MaxAttempts": 5
  },
  "RateLimits": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "VendorLocationPermitLimit": 30,
    "VendorLocationWindowSeconds": 60
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "Security": {
    "RequireHttps": false,
    "CookieName": "Eleganza.Auth"
  },
  "DataProtection": {
    "RequirePersistentKeys": false,
    "KeyRingPath": ".data-protection-keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
